NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to `true` only once Google is enabled under Supabase Auth → Providers.
# While it is unset the "Continue with Google" button is hidden, because a
# disabled provider makes it fail with "provider is not enabled".
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
